# Copy this file to `.env` and fill in your real keys.
# Vite exposes only variables prefixed with VITE_ to the browser.

# Google Maps JS API key — must have these APIs enabled in Google Cloud:
#   Maps JavaScript API, Geocoding API, Places API, Directions API
# (Restrict by HTTP referrer in the Cloud Console for production.)
VITE_GOOGLE_MAPS_API_KEY=

# Gemini API key (Google AI Studio → "Get API key")
VITE_GEMINI_API_KEY=

# Google Cloud API key with Cloud TTS + Cloud Translation enabled.
# Can be the same key as Maps if you enable all services on one key,
# or split for tighter restrictions.
VITE_GOOGLE_CLOUD_API_KEY=

# Optional: override the Gemini model used for chatbot + checklist.
# Defaults to gemini-2.5-flash if unset.
VITE_GEMINI_MODEL=gemini-2.5-flash

# Base URL of the deployed HazAlert backend (Express server in src/server/).
# Leave EMPTY in local dev — Vite's proxy forwards "/api/*" to localhost:3001.
# For static deploys (Vercel/Netlify/Firebase), set this to your backend host.
# Example: VITE_API_BASE_URL=https://ctcxgooglepromptathon-production.up.railway.app
VITE_API_BASE_URL=

# Server-side only: User-Agent the backend sends to api.weather.gov. NWS
# requires a descriptive UA with a contact for accountability.
HAZALERT_USER_AGENT=HazAlert/0.1 (contact: you@example.com)

# Port the Express backend listens on. Defaults to 3001 if unset.
PORT=3001
